# ============================================
# DATABASE — Neon PostgreSQL
# ============================================
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ============================================
# AUTH — Cookie signing
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET="change-this-to-a-random-secret"

# ============================================
# ADMIN PEMULIHAN — opsional, untuk pemilik instalasi
# ============================================
# Dipakai kalau kamu tidak bisa masuk: lupa password, atau database sudah
# berisi akun lama yang tidak kamu ketahui kredensialnya. Isi KEDUANYA di
# dashboard Vercel (Settings -> Environment Variables), redeploy, lalu login
# di aplikasi dengan nilai di bawah. Akun dibuat otomatis sebagai ADMIN pada
# percobaan login pertama — tidak perlu membuka SQL Editor.
#
# Aturan: username 3-50 karakter (huruf/angka/underscore), password 6-128
# karakter. Username yang SUDAH ada tidak disentuh, jadi pakai username baru.
# Password di-hash bcrypt dan tidak pernah ditulis ke log.
#
# HAPUS kedua variabel ini setelah berhasil masuk.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Opsional dan berbahaya kalau dibiarkan: izinkan menimpa password username di
# atas walaupun akunnya sudah ada. Hanya untuk reset akun yang benar-benar
# terkunci. Aktifkan sesaat, login, lalu hapus lagi.
# ADMIN_ALLOW_PASSWORD_RESET="true"

# ============================================
# TELEGRAM BOT — Notifikasi Telegram (opsional)
# ============================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Wajib jika webhook Telegram digunakan; daftar ulang webhook setelah diisi.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# ============================================
# WEB PUSH — Push Notifikasi Discord-style
# ============================================
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@mbg.app"

# ============================================
# CRON — Notifikasi server-side (WAJIB untuk notifikasi saat app ditutup)
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dipakai oleh /api/cron/notify. Tanpa ini endpoint cron menolak semua request.
CRON_SECRET=""

# OPSIONAL dan DESTRUKTIF: hapus riwayat lebih lama dari N hari melalui cron.
# Tanpa nilai ini riwayat tidak dipangkas; catatan terakhir setiap tugas tetap dijaga.
# TASKLOG_RETENTION_DAYS=730
